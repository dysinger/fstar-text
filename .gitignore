# macOS
.DS_Store

# nix build results (result symlinks)
result
result-*

# Makefile build output (check/krml/demo all write under out/)
out/

# F* `.checked` cache directory (hand-run `fstar.exe --cache_checked_modules`
# without `--odir` drops the cache in cwd/ `cache/`).
cache/

# Throwaway Pulse-port spike scratch dir (see AGENTS.md § Pulse-port spike)
spike/

# F* `.checked` cache, in case `fstar.exe` is run by hand without `--odir`.
# (The Makefile and default.nix both pass `--odir`, which routes these into
# out/ or the nix store — but a bare `fstar.exe` run drops them in cwd.)
*.checked
*.krml

# C compiler artifacts, in case `make` or a hand-run compile drops them in cwd.
*.o

# SMT query dumps from `fstar.exe --log_queries` (hang diagnosis)
queries-*.smt2
